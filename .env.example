# auto: MLX on Apple Silicon, PyTorch elsewhere. Install the torch extra for PyTorch.
FBU_BACKEND=auto
# PyTorch: auto selects CUDA if available, otherwise CPU. Also accepts cuda:N.
FBU_DEVICE=auto
# auto: CUDA bfloat16 when supported, otherwise float16; CPU float32.
FBU_DTYPE=auto
# Backend-specific pinned Qwen3.5-9B weights are selected automatically.
# Optional existing weights (formats are not interchangeable):
# FBU_MODEL=/absolute/path/to/Qwen3.5-9B
# FBU_MODEL=/absolute/path/to/Qwen3.5-9B-4bit
FBU_PORT=8767
FBU_HEADLESS=1
FBU_LOCALE=en-US
# Defaults: full-goal execution, one joint action/DONE score, no generated checklist.
FBU_PLAN=0
FBU_REASONING=0
FBU_DECISION_MODE=auto
FBU_SETTLE_MS=150
