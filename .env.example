# The supported Qwen3.5-9B MLX 4-bit model; its source revision is pinned by default.
FBU_MODEL=mlx-community/Qwen3.5-9B-4bit
# Or use an existing copy: FBU_MODEL=/absolute/path/to/Qwen3.5-9B-4bit
FBU_PORT=8767
FBU_HEADLESS=1
FBU_LOCALE=en-US
# Defaults: full-goal execution, one joint action/DONE score, no generated checklist.
FBU_PLAN=0
FBU_REASONING=0
FBU_DECISION_MODE=auto
FBU_SETTLE_MS=150
